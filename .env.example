# Copy to .env.local and fill in what you have. Every provider is optional:
# the AI router probes them at runtime and uses whatever answers.

# --- text generation (write/* tools, PDF summariser, transcripts summaries) ---
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
# Bytez is only used when its catalog serves the requested model id.
BYTEZ_API_KEY=

# --- optional overrides ---
# Put your preferred model first in the fallback chain, e.g. "groq:qwen/qwen3.8-27b".
# AI_PREFERRED_MODEL=
# Force a single provider (openrouter | groq | mistral | gemini | bytez).
# AI_PROVIDER=
# Seconds a failing model is skipped before it is retried. Default 600.
# AI_COOLDOWN_SECONDS=
# Per-request deadline in milliseconds. Default 60000.
# AI_TIMEOUT_MS=
# Set to 1 to log every model attempt to stderr.
# AI_DEBUG=
